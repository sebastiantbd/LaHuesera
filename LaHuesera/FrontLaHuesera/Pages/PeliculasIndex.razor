@page "/peliculas"
@inject IRepositorio Repositorio


<h3 class="text-center mt-4">Gestión de Peliculas</h3>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormulario">
        <i class="fas fa-plus"></i> Agregar Pelicula
    </button>
</div>

@if (mostrarAlerta)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}


@if (peliculas is null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando peliculas...</p>
    </div>
}
else if (!peliculas.Any())
{
    <div class="alert alert-info text-center">Iniciando Carga de Peliculas.</div>
    <div class="align-items-center">
        <img src="https://upload.wikimedia.org/wikipedia/commons/b/b1/Loading_icon.gif?20151024034921" />
    </div>

}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Descripcion</th>
                <th>Duracion</th>
                <th>Codigo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (p, index) in peliculas.Select((p, i) => (p, i + 1)))
            {
                <tr>
                    <td>@index</td>
                    <td>@p.Nombre</td>
                    <td>@p.Descripcion</td>
                    <td>@p.Duracion</td>
                    <td>@p.Codigo.ToString("C")</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => EditarPelicula(p)">
                            <i class="fas fa-edit"></i> Editar
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => EliminarPelicula(p.Id)">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(peliculaActual.Id == 0 ? "Agregar Pelicula" : "Editar Pelicula")</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="peliculaActual" OnValidSubmit="GuardarPelicula">
                        <div class="mb-3">
                            <label class="form-label">Nombre:</label>
                            <InputText class="form-control" @bind-Value="peliculaActual.Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción:</label>
                            <InputText class="form-control" @bind-Value="peliculaActual.Descripcion" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Duracion:</label>
                            <InputText class="form-control" @bind-Value="peliculaActual.Duracion" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Precio:</label>
                            <InputNumber class="form-control" @bind-Value="peliculaActual.Codigo" required />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Pelicula> peliculas = new();
    private Pelicula peliculaActual = new();
    private bool mostrarFormulario = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    [Inject] private IRepositorio Repository { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var url = "api/peliculas";
        peliculas = await Repository.GetAsync<List<Pelicula>>(url);
    }

    private void MostrarFormulario()
    {
        peliculaActual = new Pelicula();
        mostrarFormulario = true;
    }

    private void EditarPelicula(Pelicula pelicula)
    {
        peliculaActual = new Pelicula
        {
            Id = pelicula.Id,
            Nombre = pelicula.Nombre,
            Descripcion = pelicula.Descripcion,
            Duracion = pelicula.Duracion,
            Codigo = pelicula.Codigo
        };
        mostrarFormulario = true;
    }

    private async Task GuardarPelicula()
    {
        var url1 = "api/peliculas";
        var url2 = $"api/peliculas/{peliculaActual.Id}";

        if (peliculaActual.Id == 0)
            await Repositorio.PostAsync(url1, peliculaActual);
        else
            await Repositorio.PutAsync(url2, peliculaActual);

        peliculas = await Repositorio.GetAsync<List<Pelicula>>(url1);
        mostrarFormulario = false;
        mensajeAlerta = "Producto guardado exitosamente.";
        mostrarAlerta = true;
    }

    private async Task EliminarPelicula(int id)
    {
        var url1 = "api/peliculas";
        var url2 = $"api/peliculas/{id}";
        await Repositorio.DeleteAsync(url2);
        peliculas = await Repositorio.GetAsync<List<Pelicula>>(url1);
        mensajeAlerta = "Pelicula eliminada exitosamente.";
        mostrarAlerta = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}
