@page "/prestamos"
@inject IRepositorio Repositorio

<h3 class="text-center mt-4">Gestión de Préstamos</h3>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormulario">
        <i class="fas fa-plus"></i> Agregar Préstamo
    </button>
</div>

@if (mostrarAlerta)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (prestamos is null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando préstamos...</p>
    </div>
}
else if (!prestamos.Any())
{
    <div class="alert alert-info text-center">
        No hay préstamos registrados.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Usuario</th>
                <th>Película</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Entrega</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var (p, index) in prestamos.Select((p, i) => (p, i + 1)))
            {
                <tr>
                    <td>@index</td>

                    <td>
                        @usuarios.FirstOrDefault(u => u.Id == p.UsuarioId)?.Nombre
                    </td>

                    <td>
                        @peliculas.FirstOrDefault(x => x.Id == p.PeliculaId)?.Nombre
                    </td>

                    <td>@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>

                    <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>

                    <td>
                        @if (p.Estado == "Prestado")
                        {
                            <span class="badge bg-warning text-dark">Prestado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Devuelto</span>
                        }
                    </td>

                    <td>
                        @if (p.Estado == "Prestado")
                        {
                            <button class="btn btn-success btn-sm"
                                    @onclick="() => DevolverPrestamo(p)">
                                <i class="fas fa-check"></i> Devolver
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Registrar Préstamo</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="prestamoActual" OnValidSubmit="GuardarPrestamo">

                        <div class="mb-3">
                            <label class="form-label">Usuario:</label>

                            <InputSelect class="form-select"
                                         @bind-Value="prestamoActual.UsuarioId">
                                <option value="0">Seleccione un usuario</option>

                                @foreach (var u in usuarios)
                                {
                                    <option value="@u.Id">@u.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Película:</label>

                            <InputSelect class="form-select"
                                         @bind-Value="prestamoActual.PeliculaId">
                                <option value="0">Seleccione una película</option>

                                @foreach (var p in peliculas.Where(x => !prestamos!.Any(pr => pr.PeliculaId == x.Id && pr.Estado == "Prestado")))
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de Entrega:</label>

                            <InputDate class="form-control"
                                       @bind-Value="prestamoActual.FechaEntrega" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-save"></i> Guardar
                            </button>

                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {

    private List<Prestamo>? prestamos;

    private List<Usuario> usuarios = new();
    private List<Pelicula> peliculas = new();

    private Prestamo prestamoActual = new();

    private bool mostrarFormulario = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        usuarios = await Repositorio.GetAsync<List<Usuario>>("api/usuarios");

        peliculas = await Repositorio.GetAsync<List<Pelicula>>("api/peliculas");

        prestamos = await Repositorio.GetAsync<List<Prestamo>>("api/prestamoes");
    }

    private void MostrarFormulario()
    {
        prestamoActual = new Prestamo
        {
            FechaPrestamo = DateTime.Now,
            FechaEntrega = DateTime.Today.AddDays(3),
            Estado = "Prestado"
        };

        mostrarFormulario = true;
    }

    private async Task GuardarPrestamo()
    {
        if (prestamoActual.UsuarioId == 0 || prestamoActual.PeliculaId == 0)
        {
            mensajeAlerta = "Debe seleccionar un usuario y una película.";
            mostrarAlerta = true;
            return;
        }

        bool peliculaPrestada = prestamos!.Any(p =>
            p.PeliculaId == prestamoActual.PeliculaId &&
            p.Estado == "Prestado");

        if (peliculaPrestada)
        {
            mensajeAlerta = "Esta película ya se encuentra prestada.";
            mostrarAlerta = true;
            return;
        }

        prestamoActual.FechaPrestamo = DateTime.Now;
        prestamoActual.Estado = "Prestado";

        await Repositorio.PostAsync("api/prestamoes", prestamoActual);

        await CargarDatos();

        mostrarFormulario = false;

        mensajeAlerta = "Préstamo registrado exitosamente.";
        mostrarAlerta = true;
    }

    private async Task DevolverPrestamo(Prestamo prestamo)
    {
        prestamo.Estado = "Devuelto";

        var url = $"api/prestamoes/{prestamo.Id}";

        await Repositorio.PutAsync(url, prestamo);

        await CargarDatos();

        mensajeAlerta = "Película devuelta exitosamente.";
        mostrarAlerta = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}
